# =============================================================================
# Production Backend Environment Configuration (Chess Coach)
# =============================================================================

# Server Port and Node Environment
PORT=5000
NODE_ENV=production

# -----------------------------------------------------------------------------
# Database Connection (PostgreSQL with pgvector enabled)
# -----------------------------------------------------------------------------
# Examples:
# Supabase: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Neon:     postgresql://[user]:[password]@[endpoint-id].neon.tech/chesscoach?sslmode=require
# Render:   postgresql://[user]:[password]@[host]:5432/[db-name]
# Docker:   postgresql://chesscoach_user:[password]@postgres:5432/chesscoach
DATABASE_URL="postgresql://chesscoach_user:PLACEHOLDER_DB_PASSWORD@db-host:5432/chesscoach?sslmode=require"

# -----------------------------------------------------------------------------
# Allowed Client Origin (CORS & CSRF Origin validation)
# -----------------------------------------------------------------------------
# Must match the exact origin where your frontend is hosted (HTTPS required in prod).
# Example: https://chesscoach.com or https://your-app.vercel.app
CLIENT_URL="https://chesscoach.yourdomain.com"

# -----------------------------------------------------------------------------
# Production Seed Safety Control
# -----------------------------------------------------------------------------
# In production, seed scripts automatically skip the dummy dev user ('dev-user-123')
# and only seed the official curriculum modules, lessons, steps, and verified puzzles.
# Set SEED_DEV_USER="false" or leave unset.
SEED_DEV_USER="false"

# -----------------------------------------------------------------------------
# AI Coach Provider (Groq / OpenRouter / Ollama / Mock)
# -----------------------------------------------------------------------------
# Recommended for production: 'groq' (fastest ~300ms, generous free-tier)
LLM_PROVIDER="groq"
LLM_API_KEY="gsk_PLACEHOLDER_GROQ_API_KEY"
LLM_MODEL="llama-3.3-70b-versatile"

# Optional fallback or alternative:
# LLM_PROVIDER="openrouter"
# LLM_API_KEY="sk-or-v1-PLACEHOLDER_KEY"
# LLM_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# -----------------------------------------------------------------------------
# RAG Knowledge Embeddings Provider
# -----------------------------------------------------------------------------
# Set to 'mock' for deterministic offline vectors or 'ollama' if local daemon is running.
EMBEDDING_PROVIDER="mock"
EMBEDDING_MODEL="nomic-embed-text"
