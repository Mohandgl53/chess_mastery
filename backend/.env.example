# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres@localhost:5432/chess_coach?schema=public"

# Allowed Client Origin (Vite dev server)
CLIENT_URL="http://localhost:5173"

# Phase 3B: Optional seed password for the dev user (dev-user-123)
# Set this to assign a real bcryptjs-hashed password to dev@chesscoach.local.
# Required to log into dev account locally. Never commit a real value.
# After setting, run: npm run prisma:seed
# DEV_SEED_PASSWORD=your_dev_password_here

# Phase 4: Free LLM Provider Configuration
# LLM_PROVIDER: 'groq' | 'openrouter' | 'ollama' | 'mock' (default: 'mock')
# - 'mock': Deterministic mock provider (no keys required, works offline & in tests)
# - 'groq': Free tier at https://console.groq.com (no credit card required, ultra-fast ~300ms)
#           Default model: llama-3.3-70b-versatile or llama-3.1-8b-instant
# - 'openrouter': Free models at https://openrouter.ai (e.g. meta-llama/llama-3.2-3b-instruct:free)
# - 'ollama': Local LLM via Ollama (e.g. llama3.2, mistral)
LLM_PROVIDER=mock
# LLM_API_KEY=gsk_your_groq_free_key_here
# LLM_MODEL=llama-3.3-70b-versatile
# OLLAMA_BASE_URL=http://localhost:11434
