# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres@localhost:5432/chess_coach?schema=public"

# Allowed Client Origin (Vite dev server)
CLIENT_URL="http://localhost:5173"

# JWT & Session Security
# Required in production: minimum 32 random characters
JWT_SECRET=chess_mastery_secure_jwt_secret_key_change_in_production_2026
JWT_EXPIRES_IN=15m

# Google OAuth 2.0 / OpenID Connect (Optional for Google Sign-In)
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Configure Authorized JavaScript Origins: http://localhost:5173
# GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Optional seed password for the dev user (dev@chesscoach.local)
DEV_SEED_PASSWORD=test123

# Phase 4: LLM Coach Configuration
# Options: 'groq' | 'gemini' | 'mock'
LLM_PROVIDER=groq
LLM_API_KEY=your_groq_free_key_here
LLM_MODEL=llama-3.3-70b-versatile
# GEMINI_API_KEY=your_gemini_key_here

# Phase 5: RAG Embedding Configuration
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
