# Production Frontend Environment Configuration (Chess Coach)
# -----------------------------------------------------------------------------
# Data Mode: Must be 'api' for production deployment to utilize PostgreSQL persistence
VITE_DATA_MODE=api

# Backend REST API base URL
# Option A (Custom Domain with subdomains / reverse proxy):
# VITE_API_URL=https://api.yourdomain.com/api
# Option B (Shared single-domain via reverse proxy rewrite):
# VITE_API_URL=/api
# Option C (Separate cloud PaaS origin, e.g. Render/Railway):
# VITE_API_URL=https://your-chess-backend.onrender.com/api
VITE_API_URL=https://api.yourdomain.com/api
