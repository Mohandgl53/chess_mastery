{
  "name": "chess-mastery-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "test:frontend": "npm --prefix frontend test",
    "test:backend": "npm --prefix backend test",
    "test": "npm run test:backend && npm run test:frontend",
    "test:e2e": "cd frontend && npx playwright test e2e-verification.spec.ts",
    "lint:frontend": "npm --prefix frontend run lint",
    "prisma:migrate": "npm --prefix backend run prisma:migrate:deploy",
    "prisma:seed": "npm --prefix backend run prisma:seed",
    "knowledge:seed": "npm --prefix backend run knowledge:seed"
  }
}
