# Data mode: 'api' (use PostgreSQL backend REST API)
# API mode: requires real authentication (login/register)
VITE_DATA_MODE=api

# Backend REST API base URL
VITE_API_URL=http://localhost:5000/api

# Google OAuth 2.0 Client ID for Google Identity Services
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript Origins: http://localhost:5173, http://localhost
# VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
