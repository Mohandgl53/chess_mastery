# Production / Docker Compose Environment Variables
# Copy to deployment/.env when running: docker compose -f deployment/docker-compose.prod.yml up -d

PORT=5000
NODE_ENV=production

# Database Configuration
# Leave passwords empty here so Compose fails fast until you replace them.
POSTGRES_USER=chesscoach_user
POSTGRES_PASSWORD=
POSTGRES_DB=chesscoach
DB_PASSWORD=
DATABASE_URL=

# Public HTTPS origins. Required in production; localhost/empty values are rejected at boot.
# CLIENT_URL is used for CORS/CSRF; PUBLIC_CLIENT_URL is used to build email action links.
CLIENT_URL=https://chess.yourdomain.com
PUBLIC_CLIENT_URL=https://chess.yourdomain.com

# Google OAuth 2.0 Client ID (replace with your own production client)
GOOGLE_CLIENT_ID=replace_with_your_google_oauth_client_id

# JWT Secret: generate a unique random value of at least 32 characters.
# The placeholder below is intentionally rejected by the backend at startup.
JWT_SECRET=replace_with_a_unique_random_secret_at_least_32_characters

# AI LLM Provider ('groq' | 'gemini' | 'mock')
LLM_PROVIDER=groq
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# RAG Embedding Provider ('ollama' | 'mock')
EMBEDDING_PROVIDER=mock

# Email Service Configuration (Gmail SMTP)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_dedicated_gmail_address
SMTP_PASS=your_google_app_password
SMTP_FROM_NAME=Zugora

# Legacy Resend Configuration (preserved for fallback)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=Zugora <onboarding@resend.dev>
REQUIRE_EMAIL_VERIFICATION=true

