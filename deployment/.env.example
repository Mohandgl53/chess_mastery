# Production / Docker Compose Environment Variables
# Copy to deployment/.env when running: docker compose -f deployment/docker-compose.prod.yml up -d

# Database Password
DB_PASSWORD=replace_with_secure_production_password

# Client URL (browser-facing URL, e.g. http://localhost for local Docker or https://chess.yourdomain.com)
CLIENT_URL=http://localhost

# Google OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=256410331325-2ckb0m93ekb1q13beblu9tn8cvj6p3t1.apps.googleusercontent.com

# JWT Secret (minimum 32 characters)
JWT_SECRET=chess_mastery_secure_jwt_secret_key_change_in_production_2026

# AI LLM Provider ('groq' | 'gemini' | 'mock')
LLM_PROVIDER=groq
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# RAG Embedding Provider ('ollama' | 'mock')
EMBEDDING_PROVIDER=mock
